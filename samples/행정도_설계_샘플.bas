        Exit Sub
    End If

    네트웍_위치속성_모드_저장 "free"

    Dim wasProt As Boolean: wasProt = ws.ProtectContents Or ws.ProtectDrawingObjects
    On Error Resume Next: ws.Unprotect: On Error GoTo 0

