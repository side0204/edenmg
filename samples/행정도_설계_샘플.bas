    If TypeName(Sh) = "Worksheet" Then
        If Sh.Name = SHEET_NETWORK Then
            네트웍_패널_제거 Sh                       ' 옛 ← → 버튼 도형 정리 (리본으로 이전)
            네트웍_케이블_재라우팅 Sh
            네트웍_케이블박스_동기화 Sh
            배지_위치_동기화 Sh
            시설물_태그_위치_동기화 Sh
            선번화살표_재라우팅 Sh                    ' 코어 박스 이동 → 화살표 자동 재부착
        ElseIf Sh.Name = SHEET_ADMIN Then
            UpdateFloatingPanelPosition Sh
            배지_위치_동기화 Sh
            시설물_leader_재라우팅 Sh
