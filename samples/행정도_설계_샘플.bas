    ' Step2 재진입 — tier/spec 유효해서 picker 분기 안 타고 본 setup 로 진행
    If isRN1 Then
        선번연결_도구_Step2진입_RN1 cblA, curSpec, curLbl
    Else
        선번연결_도구_Step2진입_RN cblA, cblB, curSpec, curLbl
    End If
